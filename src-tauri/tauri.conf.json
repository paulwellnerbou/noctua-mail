{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctua Mail",
  "version": "0.1.0",
  "identifier": "com.noctuamail.app",
  "build": {
    "beforeDevCommand": "bun run desktop:dev-server",
    "devUrl": "http://localhost:3655",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Noctua Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": {
      "../.next/standalone": "standalone"
    }
  }
}
