{
  "name": "noctua-mail",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "author": "Paul Wellner Bou <paul@wellnerbou.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulwellnerbou/noctua-mail.git"
  },
  "homepage": "https://github.com/paulwellnerbou/noctua-mail#readme",
  "bugs": {
    "url": "https://github.com/paulwellnerbou/noctua-mail/issues"
  },
  "packageManager": "bun@1.3.12",
  "type": "module",
  "scripts": {
    "dev": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next dev",
    "build": "bun --bun build-scripts/generateBuildVersion.ts && bun --bun next build",
    "start": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next start",
    "lint": "eslint .",
    "test": "bun test",
    "test:ci": "bun test",
    "test:stress": "bun test --randomize --seed=1337 --rerun-each=3",
    "desktop:dev-server": "PORT=3655 APP_ENV_LABEL=Desktop NOCTUA_DESKTOP_MODE=true IMAP_CREDENTIALS_STORAGE=db NOCTUA_DATA_DIR=../noctua-data-desktop bun run dev",
    "desktop:dev": "bunx tauri dev",
    "desktop:build": "bash build-scripts/build-desktop.sh"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/rrule": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@lexical/history": "^0.39.0",
    "@lexical/html": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@modelcontextprotocol/sdk": "1.17.5",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@uiw/react-md-editor": "^4.0.11",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.2.17",
    "lexical": "^0.39.0",
    "lucide-react": "^0.471.2",
    "mailparser": "^3.9.6",
    "marked": "^12.0.2",
    "next": "16.1.6",
    "nodemailer": "^6.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "tsdav": "^2.1.8",
    "turndown": "^7.2.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "typescript": "^5.9.3"
  }
}
