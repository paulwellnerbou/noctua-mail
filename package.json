{
  "name": "noctua-mail",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "author": "Paul Wellner Bou <paul@wellnerbou.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulwellnerbou/noctua-mail.git"
  },
  "homepage": "https://github.com/paulwellnerbou/noctua-mail#readme",
  "bugs": {
    "url": "https://github.com/paulwellnerbou/noctua-mail/issues"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next dev",
    "build": "bun --bun build-scripts/generateBuildVersion.ts && bun --bun next build",
    "start": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next start",
    "lint": "eslint .",
    "test": "bun test --timeout 20000 && bun run test:dom",
    "test:ci": "bun test --timeout 20000 && bun run test:dom",
    "test:dom": "bun test --config=bunfig.dom.toml dom.test",
    "test:stress": "bun test --timeout 20000 --randomize --seed=1337 --rerun-each=3",
    "test:standalone-workers": "bun run build && bun --bun build-scripts/verifyStandaloneWorkerBuild.ts",
    "test:docker-workers": "bun --bun build-scripts/verifyDockerWorkerImage.ts",
    "desktop:dev-server": "PORT=3655 APP_ENV_LABEL=Desktop NOCTUA_DESKTOP_MODE=true IMAP_CREDENTIALS_STORAGE=db NOCTUA_DATA_DIR=../noctua-data-desktop bun run dev",
    "desktop:dev": "bunx tauri dev",
    "desktop:build": "bash build-scripts/build-desktop.sh"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/rrule": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@lexical/code-core": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@uiw/react-md-editor": "^4.1.3",
    "entities": "^8.1.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "lexical": "^0.52.0",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.12.4",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "parse5": "^8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-file-icon": "^1.6.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "tsdav": "^2.5.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^6.0.3"
  }
}
